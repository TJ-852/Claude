# AMP Video Automation Toolkit - Environment Configuration

# Required: HeyGen API Key
# Get your key from: https://app.heygen.com/settings/api
HEYGEN_API_KEY=your_heygen_api_key_here

# Required: ElevenLabs API Key
# Get your key from: https://elevenlabs.io/api
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Required: OpenAI API Key (for Whisper transcription and GPT-4 translation)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Default voice for TTS (ElevenLabs voice ID or name)
DEFAULT_VOICE=Rachel

# Default avatar for HeyGen (HeyGen avatar ID)
DEFAULT_AVATAR=SantaFe_v2

# GPT model for translation (gpt-4o, gpt-4-turbo, gpt-4)
GPT_MODEL=gpt-4o

# Optional: S3 bucket for output storage
# Format: s3://bucket-name or leave empty for local storage only
OUTPUT_BUCKET=

# Optional: AWS credentials (if using S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional: Maximum concurrent jobs
MAX_CONCURRENCY=3
